# Unsplash API Key (https://unsplash.com/developers)
UNSPLASH_API_KEY=your_unsplash_api_key_here

# Instagram (aliases: INSTAGRAM_USERNAME / INSTAGRAM_PASSWORD / IG_USERNAME / IG_PASSWORD)
INSTA_USERNAME=your_instagram_username
INSTA_PASSWORD=your_instagram_password

# Session file (persisted login; mount ./assets in Docker). Default: assets/instagram_session.json
# INSTAGRAM_SESSION_FILE=assets/instagram_session.json

# Optional: residential/mobile proxy (Instagram often blocks datacenter IPs)
# INSTAGRAM_PROXY=http://user:pass@host:port
# Or use standard HTTPS_PROXY / HTTP_PROXY

# Seconds to wait before login (reduce burst detection)
# INSTAGRAM_LOGIN_DELAY_SECONDS=2

# Server
PORT=5000

# Optional: Flask config (development)
# FLASK_ENV=development
# APP_CONFIG=development

# Optional: Gunicorn (Docker / production)
# GUNICORN_WORKERS=1
# GUNICORN_THREADS=8

# Optional: settings file path override
# SETTINGS_FILE=/app/assets/settings.json

# Max video length for channel-mode picks (seconds). Default 3600 (1h); skips longer uploads.
# MAX_VIDEO_DURATION_SECONDS=3600
